# =============================================================================
# ERP Backend - Environment Configuration
# =============================================================================

# --- Application ---
APP_NAME=ERP Backend
APP_VERSION=0.1.0
# ENVIRONMENT: local | development | staging | production | test
ENVIRONMENT=local
DEBUG=true

# --- API ---
API_V1_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# --- ERP Identity (Multi-ERP Platform, Phase 2) ---
# This ERP instance's stable, machine-readable identity. Not read by any
# existing module today; reserved for a future ERP_Main SSO/federation
# integration point.
ERP_KEY=yinglima
ERP_DISPLAY_NAME=Yinglima ERP

# --- Server & Service URLs ---
HOST=0.0.0.0
PORT=8001
BACKEND_URL=http://localhost:8001
FRONTEND_URL=http://localhost:5173

# --- CORS ---
# Comma-separated list, e.g. https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*

# --- Supabase Keys & Credentials ---
SUPABASE_PROJECT_ID=mpvzjzunkiqchhhvxrza
SUPABASE_REGION=ap-south-1
SUPABASE_DB_PASSWORD=Inhyma@2026
SUPABASE_SERVICE_KEY=your-supabase-service-key

# --- Database (Supabase PostgreSQL - Transaction Pooler port 6543) ---
DATABASE_URL=postgresql+asyncpg://postgres.mpvzjzunkiqchhhvxrza:Inhyma%402026@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?ssl=require
DIRECT_URL=postgresql://postgres.mpvzjzunkiqchhhvxrza:Inhyma%402026@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_ECHO=false
DATABASE_CONNECT_RETRIES=5
DATABASE_CONNECT_RETRY_DELAY_SECONDS=2.0
DATABASE_DISABLE_STATEMENT_CACHE=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Timezone ---
APP_TIMEZONE=UTC

# --- Cache backend (Phase 5) ---
CACHE_BACKEND=in_memory
CACHE_MAX_SIZE=10000
CACHE_CLEANUP_INTERVAL_SECONDS=60

# --- Authentication / JWT (Phase 2) ---
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-this-is-a-local-dev-only-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=erp-backend
ACCESS_TOKEN_EXPIRE_MINUTES=5256000
REFRESH_TOKEN_EXPIRE_DAYS=3650

# --- Password policy ---
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HISTORY_SIZE=5
PASSWORD_MAX_AGE_DAYS=90

# --- Login security / account lockout / rate limiting ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Cookie support (optional secure-cookie delivery of the refresh token) ---
AUTH_USE_SECURE_COOKIES=false
AUTH_REFRESH_COOKIE_NAME=refresh_token

# --- Bootstrap / seed data (used only by scripts/seed.py) ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!12345

# --- Queue / Background Worker (Phase 4) ---
QUEUE_BACKEND=database
QUEUE_WORKER_POLL_INTERVAL=5
QUEUE_WORKER_MAX_RETRIES=3
QUEUE_STUCK_JOB_TIMEOUT_MINUTES=30

# --- SMTP / Automated Email Dispatch ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=om1inhyma@gmail.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM_EMAIL=om1inhyma@gmail.com
SMTP_FROM_NAME=Yinglima Procurement Team
SMTP_USE_TLS=true

# --- AI Quotation Extractor (Gemini 6-Key Pool + OpenAI Fallback) ---
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2
GEMINI_API_KEY_3=your-gemini-api-key-3
GEMINI_API_KEY_4=your-gemini-api-key-4
GEMINI_API_KEY_5=your-gemini-api-key-5
GEMINI_API_KEY_6=your-gemini-api-key-6
OPENAI_API_KEY=your-openai-api-key

# --- Federation & Inter-ERP Integration ---
ERP_MAIN_ISSUER=http://127.0.0.1:8000
ERP_MAIN_JWKS_URL=http://127.0.0.1:8000/api/v1/.well-known/jwks.json
ERP_MAIN_API_BASE_URL=http://127.0.0.1:8000/api/v1
FEDERATION_CLIENT_ID=erp-yinglima-6bada2c9
FEDERATION_CLIENT_SECRET=jm-tNTpD7XgnZK3zhM6ObeJ40YsyF7NgNbPVas_p3DE
PEER_ERP_ENDPOINTS=inhyma=http://127.0.0.1:8002/api/v1,yinglima=http://127.0.0.1:8001/api/v1
FEDERATION_SERVICE_CREDENTIAL=axm17A55zQKJ.SJ8WsEwGiqk29pQoAZo1KIDpADcI5_B6Sh_VId2UTUk
YINGLIMA_SSO_ENABLED=true
