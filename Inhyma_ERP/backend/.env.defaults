# =============================================================================
# Inhyma ERP Backend - Environment Configuration
# =============================================================================

# --- Application ---
APP_NAME=Inhyma ERP Backend
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true

# --- API ---
API_V1_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# --- ERP Identity (Multi-ERP Platform, Phase 3) ---
ERP_KEY=inhyma
ERP_DISPLAY_NAME=Inhyma ERP

# --- Server & Service URLs ---
HOST=0.0.0.0
PORT=8002
BACKEND_URL=http://localhost:8002
FRONTEND_URL=http://localhost:5174

# --- CORS ---
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*

# --- Supabase Keys & Credentials ---
SUPABASE_PROJECT_ID=kkqxkgdrmvnnvptpjpmi
SUPABASE_REGION=ap-south-1
SUPABASE_DB_PASSWORD=Inhyma@2026

# --- Database (Supabase PostgreSQL - Transaction Pooler port 6543) ---
DATABASE_URL=postgresql+asyncpg://postgres.kkqxkgdrmvnnvptpjpmi:Inhyma%402026@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?ssl=require
DIRECT_URL=postgresql://postgres.kkqxkgdrmvnnvptpjpmi:Inhyma%402026@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_ECHO=false
DATABASE_CONNECT_RETRIES=5
DATABASE_CONNECT_RETRY_DELAY_SECONDS=2.0
DATABASE_DISABLE_STATEMENT_CACHE=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Timezone ---
APP_TIMEZONE=UTC

# --- Cache backend (Phase 5) ---
CACHE_BACKEND=in_memory
CACHE_MAX_SIZE=10000
CACHE_CLEANUP_INTERVAL_SECONDS=60

# --- Authentication / JWT (Phase 2) ---
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-this-is-a-local-dev-only-secret-inhyma
JWT_ALGORITHM=HS256
JWT_ISSUER=inhyma-erp-backend
ACCESS_TOKEN_EXPIRE_MINUTES=5256000
REFRESH_TOKEN_EXPIRE_DAYS=3650

# --- Password policy ---
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HISTORY_SIZE=5
PASSWORD_MAX_AGE_DAYS=90

# --- Login security / account lockout / rate limiting ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Cookie support ---
AUTH_USE_SECURE_COOKIES=false
AUTH_REFRESH_COOKIE_NAME=refresh_token

# --- Bootstrap / seed data ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!12345

# --- Queue / Background Worker (Phase 4) ---
QUEUE_BACKEND=database
QUEUE_WORKER_POLL_INTERVAL=5
QUEUE_WORKER_MAX_RETRIES=3
QUEUE_STUCK_JOB_TIMEOUT_MINUTES=30

# --- Federation & Inter-ERP Integration ---
ERP_MAIN_ISSUER=http://127.0.0.1:8000
ERP_MAIN_JWKS_URL=http://127.0.0.1:8000/api/v1/.well-known/jwks.json
ERP_MAIN_API_BASE_URL=http://127.0.0.1:8000/api/v1
FEDERATION_CLIENT_ID=erp-inhyma-9f58dc37
FEDERATION_CLIENT_SECRET=LHAT2HCDQxQ8QNTMaUG3-7s-SFX8JvCsRs4cSqnunzY
PEER_ERP_ENDPOINTS=inhyma=http://127.0.0.1:8002/api/v1,yinglima=http://127.0.0.1:8001/api/v1
FEDERATION_SERVICE_CREDENTIAL=hpL74aOCR2Sg.cwvX7VO_csHQi2fsNYfP2rezeUWVuYZbT8wYPqiNE2k
INHYMA_SSO_ENABLED=true
