# =============================================================================
# ERP Backend - Environment Configuration Example (Inhyma ERP)
#
# Copy this file to `.env` and adjust values for your local environment.
# NEVER commit a real `.env` file to version control.
# =============================================================================

# --- Application ---
APP_NAME=Inhyma ERP Backend
APP_VERSION=0.1.0
# ENVIRONMENT: local | development | staging | production | test
ENVIRONMENT=local
DEBUG=true

# --- API ---
API_V1_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# --- ERP Identity (Multi-ERP Platform, Phase 3) ---
ERP_KEY=inhyma
ERP_DISPLAY_NAME=Inhyma ERP

# Absolute path to the built frontend (the React app's `dist/` folder).
# FRONTEND_DIST_DIR=/srv/erp/frontend/dist

# --- Server & Service URLs ---
HOST=0.0.0.0
PORT=8002
BACKEND_URL=http://localhost:8002
FRONTEND_URL=http://localhost:5174

# --- CORS ---
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*

# --- Supabase Keys & Credentials ---
SUPABASE_PROJECT_ID=sxfcuarreenirvdyconu
SUPABASE_REGION=ap-northeast-1
SUPABASE_DB_PASSWORD=Inhyma@2026
SUPABASE_SERVICE_KEY=sb_secret_example_inhyma

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres.sxfcuarreenirvdyconu:Inhyma%402026@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql+psycopg2://postgres.sxfcuarreenirvdyconu:Inhyma%402026@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_ECHO=false
DATABASE_CONNECT_RETRIES=5
DATABASE_CONNECT_RETRY_DELAY_SECONDS=2.0
DATABASE_DISABLE_STATEMENT_CACHE=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Timezone ---
APP_TIMEZONE=UTC

# --- Cache backend (Phase 5) ---
CACHE_BACKEND=in_memory
CACHE_MAX_SIZE=10000
CACHE_CLEANUP_INTERVAL_SECONDS=60

# --- Authentication / JWT (Phase 2) ---
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-this-is-a-local-dev-only-secret-inhyma
JWT_ALGORITHM=HS256
JWT_ISSUER=inhyma-erp-backend
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Password policy ---
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HISTORY_SIZE=5
PASSWORD_MAX_AGE_DAYS=90

# --- Login security / account lockout / rate limiting ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Cookie support ---
AUTH_USE_SECURE_COOKIES=false
AUTH_REFRESH_COOKIE_NAME=refresh_token

# --- Bootstrap / seed data ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!12345

# --- Queue / Background Worker (Phase 4) ---
QUEUE_BACKEND=database
QUEUE_WORKER_POLL_INTERVAL=5
QUEUE_WORKER_MAX_RETRIES=3
QUEUE_STUCK_JOB_TIMEOUT_MINUTES=30
