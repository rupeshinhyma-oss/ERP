# =============================================================================
# Inhyma ERP Frontend - Environment Configuration Example
# =============================================================================

# --- Backend API Origin ---
# Leave blank ("") if using same-origin / reverse proxy (e.g. Nginx, Vite dev proxy).
# Set to full URL (e.g. "https://inhyma-erp-backend.onrender.com") if hosted on a separate domain.
VITE_API_ORIGIN=

# --- Dev Server Proxy Target ---
# Used only during local development (`npm run dev`) to proxy /api to FastAPI backend.
VITE_API_PROXY_TARGET=http://127.0.0.1:8002

# --- Application Title & Port ---
VITE_PORT=5174
VITE_APP_TITLE=Inhyma ERP

# --- Multi-ERP Platform Federation URLs ---
# Local dev values shown below; in hosted environments (e.g. Render), set to hosted URLs.
VITE_CONTROL_PLANE_URL=http://localhost:5170/dashboard
VITE_CONTROL_PLANE_API_URL=http://localhost:8000/api/v1
VITE_CENTRAL_AUTH_API=http://localhost:8000/api/v1/global/ecosystem-session
VITE_COOKIE_DOMAIN=

# --- Ecosystem ERP URLs ---
VITE_INHYMA_URL=http://localhost:5174/dashboard
VITE_INHYMA_API_URL=http://localhost:8002/api/v1
VITE_YINGLIMA_URL=http://localhost:5173/dashboard
VITE_YINGLIMA_API_URL=http://localhost:8001/api/v1

# --- External Third-Party APIs ---
# Google Maps Platform API Key (Places Autocomplete, Maps JS, Geocoding)
VITE_GOOGLE_MAPS_API_KEY=
