# =============================================================================
# Inhyma ERP Frontend - Environment Configuration Example
# =============================================================================

# --- Backend API Origin ---
# Leave blank ("") if using same-origin / reverse proxy (e.g. Nginx, Render rewrite).
# Set to full URL (e.g. "https://api.yourdomain.com") if hosted on a separate domain.
VITE_API_ORIGIN=

# --- Dev Server Proxy Target ---
# Used only during local development (`npm run dev`) to proxy /api to FastAPI backend.
VITE_API_PROXY_TARGET=http://127.0.0.1:8002

# --- Application Title & Port ---
VITE_PORT=5174
VITE_APP_TITLE=Inhyma ERP

# --- Multi-ERP Platform Federation (Optional Overrides) ---
# Global Control Plane URL (ERP_Main). Default in local dev: http://localhost:5170/dashboard
VITE_CONTROL_PLANE_URL=
# Global Control Plane API endpoint. Default in local dev: http://localhost:8000/api/v1
VITE_CONTROL_PLANE_API_URL=
# Central ecosystem session endpoint (e.g. "https://admin-api.yourdomain.com/api/v1/global/ecosystem-session")
VITE_CENTRAL_AUTH_API=
# Shared cookie domain for cross-subdomain SSO (e.g. ".yourcompany.com")
VITE_COOKIE_DOMAIN=

# --- Peer ERP URLs (Optional) ---
VITE_YINGLIMA_URL=
VITE_YINGLIMA_API_URL=

# --- External Third-Party APIs ---
# Google Maps Platform API Key (Places Autocomplete, Maps JS, Geocoding)
VITE_GOOGLE_MAPS_API_KEY=
