# =============================================================================
# ERP_Main - Global Control Plane - Environment Configuration
#
# Phase 2 scope note: ERP_Main has no authentication yet, so there are no
# secrets to protect in this phase (no JWT signing key, no API tokens).
# This file is kept separate from any future secrets file on purpose (see
# Phase 2 Step 16: "Separate SECRETS from NON-SECRET ERP CONFIGURATION"),
# so that when auth/SSO secrets are introduced in a later phase they land
# in their own file/vault rather than here.
# =============================================================================

APP_NAME=ERP_Main - Global Control Plane
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=false

API_V1_PREFIX=/api/v1

# ERP_Main's own database. NEVER point this at Yinglima's (or any other
# ERP's) DATABASE_URL -- see docs/MULTI_ERP_ARCHITECTURE.md §6.
DATABASE_URL=sqlite+aiosqlite:///./erp_main.db
DATABASE_ECHO=false

CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
