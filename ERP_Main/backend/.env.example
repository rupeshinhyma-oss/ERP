# =============================================================================
# ERP_Main - Global Control Plane - Environment Configuration
# =============================================================================

APP_NAME=ERP_Main - Global Control Plane
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=false

API_V1_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# --- Server & Service URLs ---
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5170

# --- Supabase Keys & Credentials ---
SUPABASE_PROJECT_ID=<PROJECT_REF>
SUPABASE_REGION=ap-south-1
SUPABASE_DB_PASSWORD=<DB_PASSWORD>

# --- Database (Supabase PostgreSQL - Session Pooler port 5432) ---
DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?ssl=require
DIRECT_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_DISABLE_STATEMENT_CACHE=true
DATABASE_ECHO=false

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5170,http://localhost:5173,http://localhost:5174
CORS_ALLOW_CREDENTIALS=true

# --- Platform Admin Authentication (Phase 3) ---
PLATFORM_JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-platform-admin-secret
PLATFORM_JWT_ALGORITHM=HS256
PLATFORM_JWT_ISSUER=erp-main-control-plane
PLATFORM_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- ERP Service Identity / Credentials (Phase 3) ---
SERVICE_CREDENTIAL_PEPPER=CHANGE-ME-IN-PRODUCTION-service-credential-pepper
