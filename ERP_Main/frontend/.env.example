# =============================================================================
# ERP_Main Frontend (Global Control Plane) - Environment Configuration Example
# =============================================================================

# --- Backend API Origin ---
# Leave blank ("") if using same-origin / reverse proxy (e.g. Nginx, Render rewrite).
# Set to full URL (e.g. "https://admin-api.yourdomain.com") if hosted on a separate domain.
VITE_API_ORIGIN=

# --- Dev Server Proxy Target ---
# Used only during local development (`npm run dev`) to proxy /api to FastAPI backend.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# --- Application Title & Port ---
VITE_PORT=5170
VITE_APP_TITLE=ERP_Main Control Plane

# --- Multi-ERP Platform Federation Overrides ---
# Central Control Plane URL (Self)
VITE_CONTROL_PLANE_URL=
# Central ecosystem session endpoint (e.g. "https://admin-api.yourdomain.com/api/v1/global/ecosystem-session")
VITE_CENTRAL_AUTH_API=
# Shared cookie domain for cross-subdomain SSO (e.g. ".yourcompany.com")
VITE_COOKIE_DOMAIN=

# --- Target Managed ERP URLs (Used by Switcher / Launch Buttons) ---
VITE_YINGLIMA_URL=
VITE_YINGLIMA_API_URL=
VITE_INHYMA_URL=
VITE_INHYMA_API_URL=
